<Window x:Class="AI.FilmStudio.AutomationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="一键自动生产" Width="1240" Height="760" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition/><RowDefinition Height="48"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid Grid.ColumnSpan="3"><StackPanel><TextBlock Text="一键全流程自动生产" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="全量分镜 → 冻结设定 → 关键帧 → VLM质检/修复 → 视频 → 配音字幕 → 时间线 → 成片" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource NavButton}" Content="模型设置" Click="Settings_Click"/></Grid>
  <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="15"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="生产配置" FontSize="17" FontWeight="SemiBold"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="集数"/><ComboBox x:Name="Episode" Height="34" Margin="0,5,0,10"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="模式"/><ComboBox x:Name="Mode" SelectedIndex="1" Height="34" Margin="0,5,0,10"><ComboBoxItem Content="质量优先" Tag="quality"/><ComboBoxItem Content="均衡" Tag="balanced"/><ComboBoxItem Content="经济" Tag="economy"/></ComboBox></StackPanel></Grid><TextBlock Text="成片画幅"/><ComboBox x:Name="Aspect" SelectedIndex="0" Height="34" Margin="0,5,0,10"><ComboBoxItem Content="9:16 竖屏短剧 · 1080×1920" Tag="portrait"/><ComboBoxItem Content="16:9 横屏 · 1920×1080" Tag="landscape"/><ComboBoxItem Content="1:1 方形 · 1080×1080" Tag="square"/></ComboBox><TextBlock Text="关键帧提供方"/><ComboBox x:Name="ImageProvider" DisplayMemberPath="DisplayName" Height="34" Margin="0,5,0,10"/><TextBlock Text="关键帧模型"/><TextBox x:Name="ImageModel" Text="gpt-image-2" Height="34" Padding="7" Margin="0,5,0,10"/><TextBlock Text="视频提供方"/><ComboBox x:Name="VideoProvider" DisplayMemberPath="DisplayName" SelectionChanged="VideoProvider_SelectionChanged" Height="34" Margin="0,5,0,10"/><TextBlock Text="视频模型"/><TextBox x:Name="VideoModel" Text="wan2.7-i2v-2026-04-25" Height="34" Padding="7" Margin="0,5,0,10"/><CheckBox x:Name="EnableVoice" Content="生成对白、自动字幕并混入成片" IsChecked="True" Foreground="{StaticResource TextBrush}"/><CheckBox x:Name="EnableReview" Content="使用 OpenAI VLM 检查关键帧并自动修复" Foreground="{StaticResource TextBrush}" Margin="0,7,0,0"/><TextBlock Text="成片名称" Margin="0,12,0,0"/><TextBox x:Name="OutputName" Text="第1集-自动成片.mp4" Height="34" Padding="7" Margin="0,5,0,12"/><Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="开始全流程自动生产" Click="Start_Click"/></StackPanel></ScrollViewer></Border>
  <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions><Grid><TextBlock Text="自动生产运行记录" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource NavButton}" Content="刷新" Click="Refresh_Click"/><Button Style="{StaticResource NavButton}" Content="取消选中" Click="Cancel_Click"/><Button Style="{StaticResource NavButton}" Content="打开成片" Click="Open_Click"/></StackPanel></Grid><DataGrid x:Name="RunGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#101318" Foreground="{StaticResource TextBrush}" RowBackground="#171A20" AlternatingRowBackground="#1B1F26" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/><DataGridTextColumn Header="集" Binding="{Binding Episode}" Width="45"/><DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="75"/><DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="130"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="进度" Binding="{Binding Progress, StringFormat={}{0}%}" Width="70"/><DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="*"/><DataGridTextColumn Header="成片" Binding="{Binding OutputPath}" Width="200"/></DataGrid.Columns></DataGrid></Grid></Border>
  <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="3" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
 </Grid>
</Window>
