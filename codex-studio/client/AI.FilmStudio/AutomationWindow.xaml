<Window x:Class="AI.FilmStudio.AutomationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一键自动生产" Width="1240" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition/><RowDefinition Height="52"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="3">
            <StackPanel><TextBlock Text="一键全流程自动生产" FontSize="26" FontWeight="Bold"/><TextBlock Text="全量分镜 → 冻结设定 → 关键帧 → 质检修复 → 视频 → 配音字幕 → 时间线 → 成片" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource NavButton}" Content="管理模型岗位" Click="Settings_Click"/>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="生产配置" FontSize="19" FontWeight="Bold"/>
                        <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="集数" FontWeight="SemiBold"/><ComboBox x:Name="Episode" Height="42" Margin="0,6,0,10" SelectionChanged="Episode_SelectionChanged"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="模式" FontWeight="SemiBold"/><ComboBox x:Name="Mode" SelectedIndex="1" Height="42" Margin="0,6,0,10"><ComboBoxItem Content="质量优先" Tag="quality"/><ComboBoxItem Content="均衡" Tag="balanced"/><ComboBoxItem Content="经济" Tag="economy"/></ComboBox></StackPanel>
                        </Grid>
                        <TextBlock Text="成片画幅" FontWeight="SemiBold"/><ComboBox x:Name="Aspect" SelectedIndex="0" Height="42" Margin="0,6,0,11"><ComboBoxItem Content="9:16 竖屏短剧 · 1080×1920" Tag="portrait"/><ComboBoxItem Content="16:9 横屏 · 1920×1080" Tag="landscape"/><ComboBoxItem Content="1:1 方形 · 1080×1080" Tag="square"/></ComboBox>
                        <CheckBox x:Name="EnableVoice" Content="生成对白、自动字幕并混入成片" IsChecked="True" Margin="0,3,0,0" Click="Options_Click"/>
                        <CheckBox x:Name="EnableReview" Content="执行视觉质检并自动修复失败镜头" Margin="0,9,0,0" Click="Options_Click"/>
                        <TextBlock Text="成片名称" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBox x:Name="OutputName" Text="第1集-自动成片.mp4" Height="42" Margin="0,6,0,0"/>
                        <Border Background="#202630" BorderBrush="#536075" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid><TextBlock Text="当前岗位路由（只读）" FontSize="18" FontWeight="Bold"/><Button HorizontalAlignment="Right" Style="{StaticResource NavButton}" Content="刷新" Click="RefreshRoutes_Click" Padding="10,5"/></Grid>
                                <TextBlock Text="自动生产只使用模型路由中心的绑定，不再维护第二套手填模型。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <TextBlock x:Name="ImageRouteText" Text="关键帧：读取中…" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock x:Name="VideoRouteText" Text="正式视频：读取中…" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock x:Name="TransitionRouteText" Text="镜间桥接：读取中…" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock x:Name="VoiceRouteText" Text="角色配音：读取中…" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock x:Name="ReviewRouteText" Text="连续性质检：读取中…" TextWrapping="Wrap" Margin="0,3"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Margin="0,13,0,0">
                    <TextBlock x:Name="LockStatusText" Text="正在检查全量分镜门禁…" Foreground="#FFD166" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,9"/>
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="开始全流程自动生产" Click="Start_Click" Padding="18,12"/>
                    <TextBlock x:Name="RouteBlockerText" Foreground="#FFD166" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="190"/><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions>
                <Grid><TextBlock Text="生成前模型路由预检" FontSize="18" FontWeight="Bold"/><Button HorizontalAlignment="Right" Style="{StaticResource NavButton}" Content="刷新预检" Click="Preview_Click"/></Grid>
                <DataGrid x:Name="RouteGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="镜头" Binding="{Binding ShotNumber}" Width="70"/><DataGridTextColumn Header="价值" Binding="{Binding ValueScore}" Width="55"/><DataGridTextColumn Header="提供方" Binding="{Binding Provider}" Width="90"/><DataGridTextColumn Header="模型" Binding="{Binding Model}" Width="170"/><DataGridTextColumn Header="分辨率" Binding="{Binding Resolution}" Width="75"/><DataGridTextColumn Header="秒" Binding="{Binding Seconds}" Width="45"/><DataGridTextColumn Header="路由原因" Binding="{Binding RouteReason}" Width="*"/></DataGrid.Columns></DataGrid>
                <Grid Grid.Row="2"><TextBlock Text="自动生产运行记录" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource NavButton}" Content="刷新" Click="Refresh_Click"/><Button Style="{StaticResource NavButton}" Content="取消选中" Click="Cancel_Click"/><Button Style="{StaticResource NavButton}" Content="打开成片" Click="Open_Click"/></StackPanel></Grid>
                <DataGrid x:Name="RunGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/><DataGridTextColumn Header="集" Binding="{Binding Episode}" Width="45"/><DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="75"/><DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="130"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="进度" Binding="{Binding Progress, StringFormat={}{0}%}" Width="70"/><DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="*"/><DataGridTextColumn Header="成片" Binding="{Binding OutputPath}" Width="180"/></DataGrid.Columns></DataGrid>
            </Grid>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="3" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
</Window>
