<Window x:Class="AI.FilmStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI影视Studio" Width="1600" Height="960" MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="62"/><RowDefinition/><RowDefinition Height="245"/><RowDefinition Height="58"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111318" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentBrush}"><TextBlock Text="◇" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="AI影视Studio" FontWeight="SemiBold" FontSize="20" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel x:Name="TopNavigation" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="HomeNavButton" Style="{StaticResource ActiveNavButton}" Content="首页" Click="TopNav_Click" Tag="首页" Padding="11,9"/><Button Style="{StaticResource NavButton}" Content="项目" Click="TopNav_Click" Tag="项目" Padding="11,9"/><Button Style="{StaticResource NavButton}" Content="剧本" Click="TopNav_Click" Tag="剧本" Padding="11,9"/><Button Style="{StaticResource NavButton}" Content="分镜" Click="TopNav_Click" Tag="分镜" Padding="11,9"/><Button Style="{StaticResource NavButton}" Content="制作" Click="TopNav_Click" Tag="制作" Padding="11,9"/><Button Style="{StaticResource NavButton}" Content="剪辑" Click="TopNav_Click" Tag="剪辑" Padding="11,9"/><Button Style="{StaticResource NavButton}" Content="发布" Click="TopNav_Click" Tag="发布" Padding="11,9"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse x:Name="ServiceDot" Width="9" Height="9" Fill="#E0A534"/><TextBlock x:Name="ServiceText" Text="本地服务检测中" Foreground="{StaticResource MutedBrush}" Margin="8,0,10,0" VerticalAlignment="Center"/><Button x:Name="ModelSettingsButton" AutomationProperties.AutomationId="ModelSettingsButton" Style="{StaticResource NavButton}" Content="⚙ 模型" Click="ProviderSettings_Click" Padding="12,9"/><TextBlock x:Name="ActiveProjectText" Text="未选择项目" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#14171C" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <StackPanel x:Name="WorkspaceNavigation" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource NavButton}" Content="剧本" Click="Workspace_Click" Tag="director" Padding="16,11"/><Button Style="{StaticResource NavButton}" Content="分镜" Click="Workspace_Click" Tag="storyboard" Padding="16,11"/><Button Style="{StaticResource NavButton}" Content="设定集" Click="Workspace_Click" Tag="bible" Padding="16,11"/><Button Style="{StaticResource NavButton}" Content="AI生成" Click="Workspace_Click" Tag="generation" Padding="16,11"/><Button Style="{StaticResource NavButton}" Content="一键生产" Click="Workspace_Click" Tag="automation" Padding="16,11"/><Button Style="{StaticResource NavButton}" Content="剪辑导出" Click="Workspace_Click" Tag="editing" Padding="16,11"/><Button Style="{StaticResource NavButton}" Content="资产" Click="Workspace_Click" Tag="assets" Padding="16,11"/><Button Style="{StaticResource NavButton}" Content="任务" Click="Workspace_Click" Tag="tasks" Padding="16,11"/>
            </StackPanel>
        </Border>

        <Grid x:Name="HomeDashboard" Grid.Row="2" Grid.RowSpan="3" Margin="24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition/></Grid.RowDefinitions>
            <Border Background="#191D24" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="28">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="首页" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="HomeWelcomeText" Text="从项目开始，按剧本 → 全量分镜 → 设定集 → AI生成 → 剪辑导出的顺序制作。" FontSize="17" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="管理项目" Click="ProjectManager_Click" Padding="24,13" VerticalAlignment="Center"/></Grid>
            </Border>
            <UniformGrid Grid.Row="2" Columns="4">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,10,0"><StackPanel><TextBlock Text="当前项目" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="HomeProjectName" Text="尚未选择" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock x:Name="HomeProjectMeta" Text="新建或选择项目开始" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,10,0"><StackPanel><TextBlock Text="全量分镜" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="HomeShotCount" Text="0 镜" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="完成全量分镜后再批量生成" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,10,0"><StackPanel><TextBlock Text="连续性设定" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="HomeBibleCount" Text="0 项" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="人物、场景、道具版本化管理" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="本地服务" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="HomeServiceText" Text="正在检测" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="项目数据与任务在本机持久化" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="开始制作" FontSize="22" FontWeight="SemiBold"/><UniformGrid Grid.Row="2" Columns="4">
                    <Button Style="{StaticResource NavButton}" Click="Workspace_Click" Tag="director" Margin="0,0,10,0" Padding="18"><StackPanel><TextBlock Text="1  剧本" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="导入、保存并解析完整剧本" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="Workspace_Click" Tag="storyboard" Margin="0,0,10,0" Padding="18"><StackPanel><TextBlock Text="2  分镜" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="生成、校对并锁定全量分镜" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="Workspace_Click" Tag="generation" Margin="0,0,10,0" Padding="18"><StackPanel><TextBlock Text="3  AI生成" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="按镜头价值路由图片与视频模型" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="Workspace_Click" Tag="editing" Padding="18"><StackPanel><TextBlock Text="4  剪辑导出" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="组装音画字幕并输出成片" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
                </UniformGrid></Grid>
            </Border>
        </Grid>

        <Grid x:Name="WorkspaceShell" Visibility="Collapsed" Grid.Row="2" Grid.RowSpan="3" Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,8">
                    <StackPanel><TextBlock Text="项目管理" FontSize="17" FontWeight="SemiBold"/><ComboBox x:Name="ProjectSelector" DisplayMemberPath="Name" Height="40" Margin="0,14,0,8" SelectionChanged="ProjectSelector_SelectionChanged"/><Border Background="#2B2646" CornerRadius="6" Padding="10" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="45" Height="62" Background="#38414B" CornerRadius="4"><TextBlock Text="制" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="CurrentProjectName" Text="正在加载项目" FontWeight="SemiBold"/><TextBlock x:Name="CurrentProjectMeta" Text="本地持久化工程" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,6,0,0"/></StackPanel></Grid></Border>
                        <Button Style="{StaticResource PrimaryButton}" Content="＋ 新建项目" Click="NewProject_Click" Margin="0,0,0,8"/><TextBlock Text="幕节列表" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6"/><ListBox x:Name="EpisodeList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" SelectionChanged="EpisodeList_SelectionChanged"/><Button Style="{StaticResource NavButton}" Content="↻ 刷新项目数据" Click="RefreshProject_Click" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="真实项目统计" FontWeight="SemiBold"/><UniformGrid Columns="4" Margin="0,12,0,0"><StackPanel><TextBlock Text="角色" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CharacterCountText" Text="0" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="场景" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SceneCountText" Text="0" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="道具" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PropCountText" Text="0" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="镜头" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ShotCountText" Text="0" FontSize="20"/></StackPanel></UniformGrid></StackPanel></Border>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid><TextBlock x:Name="WorkspaceTitle" Text="项目工作台" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource NavButton}" Content="剧本工作台" Click="TopNav_Click" Tag="剧本"/><Button Style="{StaticResource PrimaryButton}" Content="分镜工作台" Click="TopNav_Click" Tag="分镜"/></StackPanel></Grid>
                    <Grid Grid.Row="1"><TextBlock x:Name="EmptyShotsText" Text="项目尚无镜头。打开剧本工作台，导入剧本并生成全量分镜。" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="ShotList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="190" Height="300" Background="{Binding Color}" CornerRadius="7" Margin="0,0,10,0" BorderBrush="#434A57" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition/></Grid.RowDefinitions><Grid Background="#252A32"><TextBlock Text="{Binding Number}" Background="#15171B" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"/><TextBlock Text="◈" FontSize="44" Foreground="#9BA6B8" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding Duration}" Background="#15171B" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"/></Grid><StackPanel Grid.Row="1" Margin="10"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,8,0,0"/><Border Background="#203D2E" CornerRadius="4" Padding="7,4" HorizontalAlignment="Left" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" Foreground="#68E19A" FontSize="15"/></Border></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8"><StackPanel><TextBlock Text="连续性控制台" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="人物、场景、道具、动作、镜位和光照状态以版本化契约保存。只有真实镜头进入工程后才计算分数。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/><Border Background="#203D2E" CornerRadius="5" Padding="9" Margin="0,14,0,0"><TextBlock Text="● 连续性引擎已就绪" Foreground="#57C582"/></Border></StackPanel></Border>
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8"><StackPanel><TextBlock Text="镜间衔接" FontWeight="SemiBold"/><TextBlock Text="支持动作相位、屏幕方向、色温和场景锚点检测，并可生成 FFmpeg 本地转场任务。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/><Button Style="{StaticResource PrimaryButton}" Content="打开真实转场渲染" HorizontalAlignment="Left" Click="GenerateTransition_Click"/></StackPanel></Border>
                <Border Style="{StaticResource PanelBorder}"><StackPanel><TextBlock Text="当前状态" FontWeight="SemiBold"/><TextBlock Text="尚未分析镜头。导入或生成镜头后，这里将显示真实发现和可执行修复建议。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel></Border>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
