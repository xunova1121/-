<Window x:Class="AI.FilmStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI影视Studio" Width="1500" Height="920" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="54"/><RowDefinition/><RowDefinition Height="245"/><RowDefinition Height="54"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111318" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}"><TextBlock Text="◇" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="AI影视Studio" FontWeight="SemiBold" FontSize="17" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource NavButton}" Content="项目" Click="TopNav_Click" Tag="项目"/><Button Style="{StaticResource NavButton}" Content="剧本" Click="TopNav_Click" Tag="剧本"/><Button Style="{StaticResource NavButton}" Content="分镜" Click="TopNav_Click" Tag="分镜"/><Button Style="{StaticResource NavButton}" Content="制作" Click="TopNav_Click" Tag="制作"/><Button Style="{StaticResource NavButton}" Content="剪辑" Click="TopNav_Click" Tag="剪辑"/><Button Style="{StaticResource NavButton}" Content="发布" Click="TopNav_Click" Tag="发布"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse x:Name="ServiceDot" Width="8" Height="8" Fill="#E0A534"/><TextBlock x:Name="ServiceText" Text="本地服务检测中" Foreground="{StaticResource MutedBrush}" Margin="7,0,18,0" VerticalAlignment="Center"/><TextBlock Text="雪山剑客 第一季⌄" VerticalAlignment="Center"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#14171C" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource NavButton}" Content="◉ 导演工作台" Click="Workspace_Click" Tag="director"/><Button Style="{StaticResource NavButton}" Content="▧ 分镜工作台" Click="Workspace_Click" Tag="storyboard"/><Button Style="{StaticResource NavButton}" Content="▣ 视频生成" Click="Workspace_Click" Tag="generation"/><Button Style="{StaticResource PrimaryButton}" Content="⌁ 剪辑工作台" Click="Workspace_Click" Tag="editing"/><Button Style="{StaticResource NavButton}" Content="♙ 资产管理" Click="Workspace_Click" Tag="assets"/><Button Style="{StaticResource NavButton}" Content="▤ 任务队列" Click="Workspace_Click" Tag="tasks"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,8">
                    <StackPanel><TextBlock Text="项目管理" FontSize="16" FontWeight="SemiBold"/><Border Background="#2B2646" CornerRadius="6" Padding="10" Margin="0,14,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="45" Height="62" Background="#38414B" CornerRadius="4"><TextBlock Text="雪" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="雪山剑客 第一季" FontWeight="SemiBold"/><TextBlock Text="类型：武侠 / 剧情" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="12集 · 总时长 45:32" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel></Grid></Border>
                        <TextBlock Text="幕节列表（12）" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><ListBox x:Name="EpisodeList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" SelectionChanged="EpisodeList_SelectionChanged">
                            <ListBoxItem IsSelected="True">第1集  雪夜杀局          04:32</ListBoxItem><ListBoxItem>第2集  追杀              04:58</ListBoxItem><ListBoxItem>第3集  秘密              05:12</ListBoxItem><ListBoxItem>第4集  血战              06:35</ListBoxItem><ListBoxItem>第5集  决战之前          07:55</ListBoxItem><ListBoxItem>第6集  往事              03:45</ListBoxItem>
                        </ListBox><Button Style="{StaticResource NavButton}" Content="＋ 新建章节" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="资产概览" FontWeight="SemiBold"/><UniformGrid Columns="4" Margin="0,12,0,0"><StackPanel><TextBlock Text="角色" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="12" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="场景" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="42" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="道具" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="28" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="镜头" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="386" FontSize="20"/></StackPanel></UniformGrid></StackPanel></Border>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid><TextBlock x:Name="WorkspaceTitle" Text="剪辑工作台 · 第1集 雪夜杀局" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource NavButton}" Content="＋ 导入镜头"/><Button Style="{StaticResource NavButton}" Content="自动剪辑"/></StackPanel></Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="ShotList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="180" Height="290" Background="{Binding Color}" CornerRadius="7" Margin="0,0,8,0" BorderBrush="#363B46" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition/></Grid.RowDefinitions><Grid Background="#252A32"><TextBlock Text="{Binding Number}" Background="#15171B" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"/><TextBlock Text="◈" FontSize="44" Foreground="#687080" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding Duration}" Background="#15171B" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"/></Grid><StackPanel Grid.Row="1" Margin="10"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/><Border Background="#203D2E" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" Foreground="#57C582" FontSize="12"/></Border></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8"><StackPanel><TextBlock Text="AI导演助手" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,14,0,12"><TextBlock Text="分析" Foreground="#A78FFF" Margin="12,0,35,0"/><TextBlock Text="建议" Foreground="{StaticResource MutedBrush}" Margin="0,0,35,0"/><TextBlock Text="检查" Foreground="{StaticResource MutedBrush}"/></StackPanel><TextBlock Text="镜头连贯性分析" FontWeight="SemiBold"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="82" Height="82" BorderBrush="#27B769" BorderThickness="8" CornerRadius="41"><TextBlock Text="86" FontSize="28" Foreground="#35C879" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="总体连贯性良好"/><TextBlock Text="人物一致性       92%" Foreground="#56CC88" Margin="0,7,0,0"/><TextBlock Text="场景一致性       88%" Foreground="#56CC88"/><TextBlock Text="动作连贯性       75%" Foreground="#E1AB42"/><TextBlock Text="光影一致性       89%" Foreground="#56CC88"/></StackPanel></Grid></StackPanel></Border>
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8"><StackPanel><TextBlock Text="问题检测（2）" FontWeight="SemiBold"/><TextBlock Text="⚠ 镜头005 → 006" Foreground="#E7AE42" Margin="0,12,0,0"/><TextBlock Text="动作跨度较大，建议增加过渡镜头" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="18,5,0,8"/><Button Style="{StaticResource PrimaryButton}" Content="生成过渡镜头" HorizontalAlignment="Left"/><TextBlock Text="⚠ 镜头012" Foreground="#E7AE42" Margin="0,12,0,0"/><TextBlock Text="光影与前后镜头差异较大" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="18,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource PanelBorder}"><StackPanel><TextBlock Text="AI建议" FontWeight="SemiBold"/><TextBlock Text="在镜头003和004之间加入1.2秒转场，使用推镜+光影渐变，可增强氛围。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,12"/><Button Style="{StaticResource PrimaryButton}" Content="✦ 应用建议"/></StackPanel></Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="#12151A" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="时间线 · 雪夜杀局" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="00:00:00     00:00:05     00:00:10     00:00:15     00:00:20     00:00:25     00:00:30     00:00:35" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="视频轨道  V1     🔒  ◉" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Border Grid.Row="1" Grid.Column="1" Background="#28313C" CornerRadius="4" Margin="0,3"><TextBlock Text="001  雪山全景       002  李狗蛋独行       003  人物特写       004  古寺大门       005  遗迹       006  黑衣人" VerticalAlignment="Center" Margin="10,0"/></Border>
            <TextBlock Grid.Row="2" Text="转场轨道           🔒  ◉" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"><Border Width="100" Background="#42366E" CornerRadius="4" Margin="110,3,0,3"><TextBlock Text="转场" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="100" Background="#42366E" CornerRadius="4" Margin="180,3,0,3"><TextBlock Text="转场" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
            <TextBlock Grid.Row="3" Text="音频轨道  A1     🔒  ◉" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Border Grid.Row="3" Grid.Column="1" Background="#183D2A" CornerRadius="4" Margin="0,3"><TextBlock Text="▂▃▅▆▃▂▅▇▆▃▂▂▅▆▅▃▂▅▇▆▅▃▂▃▅▆▃▂▅▇▆▃▂▂▅▆▅▃▂▅▇▆▅▃" Foreground="#36B76B" VerticalAlignment="Center" Margin="8,0"/></Border>
            <TextBlock Grid.Row="4" Text="字幕轨道  T1     🔒  ◉" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><Border Width="260" Background="#5A371B" CornerRadius="4" Margin="0,3,6,3"><TextBlock Text="风雪漫天，江湖路远……" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="440" Background="#5A371B" CornerRadius="4" Margin="0,3,6,3"><TextBlock Text="李狗蛋独自一人，寻找师父的下落" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="300" Background="#5A371B" CornerRadius="4" Margin="0,3"><TextBlock Text="前方似有危险……" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
        </Grid></Border>

        <Border Grid.Row="4" Background="#111318"><Grid Margin="215,0,18,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource NavButton}" Content="|◀"/><Button Style="{StaticResource NavButton}" Content="▶"/><Button Style="{StaticResource NavButton}" Content="▶|"/><TextBlock Text="00:00:10:12 / 00:04:32:18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="20,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="缩放" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/><Slider Width="120" Minimum="0" Maximum="100" Value="40"/></StackPanel></Grid></Border>
    </Grid>
</Window>

