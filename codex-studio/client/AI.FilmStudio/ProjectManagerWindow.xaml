<Window x:Class="AI.FilmStudio.ProjectManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="项目管理" Width="900" Height="590" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition/><RowDefinition Height="48"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid Grid.ColumnSpan="3"><StackPanel><TextBlock Text="项目管理" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="创建、选择、重命名或移除本地工程；移除工程不会删除磁盘中的媒体文件。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Content="＋ 新建项目" Click="New_Click"/></Grid>
  <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="10"><ListBox x:Name="ProjectList" DisplayMemberPath="Name" Background="#101318" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource StrokeBrush}" SelectionChanged="ProjectList_SelectionChanged"/></Border>
  <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="工程信息" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="名称" Margin="0,18,0,0"/><TextBox x:Name="ProjectName" Height="36" Padding="8" Margin="0,5,0,12"/><TextBlock Text="类型 / 题材"/><TextBox x:Name="Genre" Height="36" Padding="8" Margin="0,5,0,12"/><TextBlock Text="计划集数"/><TextBox x:Name="EpisodeCount" Height="36" Padding="8" Margin="0,5,0,18"/><StackPanel Orientation="Horizontal"><Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="保存修改" Click="Save_Click"/><Button AutomationProperties.AutomationId="SelectCurrentProjectButton" Style="{StaticResource NavButton}" Content="设为当前项目" Click="Select_Click"/><Button Style="{StaticResource NavButton}" Content="移除工程" Foreground="#F06B6B" Click="Delete_Click"/></StackPanel><TextBlock x:Name="Feedback" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border>
  <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
 </Grid>
</Window>
