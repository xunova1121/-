<Window x:Class="AI.FilmStudio.PrevizWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="空间预演台" Width="1380" Height="820" MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="空间与机位" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="拖动画布中的机位、目标和人物；每次保存形成不可变版本，并与上一机位检查越轴。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,16"/>
                <TextBlock Text="场景键"/><TextBox x:Name="SceneKey" Text="scene-01" Height="34" Padding="7" Margin="0,4,0,8"/>
                <Button Style="{StaticResource NavButton}" Content="加载该场景版本" Click="Refresh_Click" Margin="0,0,0,14"/>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,5,8"><TextBlock Text="机位 X"/><TextBox x:Name="CameraX" Text="0" TextChanged="Field_TextChanged"/></StackPanel>
                    <StackPanel Margin="5,0,0,8"><TextBlock Text="机位 Y"/><TextBox x:Name="CameraY" Text="-5" TextChanged="Field_TextChanged"/></StackPanel>
                    <StackPanel Margin="0,0,5,8"><TextBlock Text="目标 X"/><TextBox x:Name="TargetX" Text="0" TextChanged="Field_TextChanged"/></StackPanel>
                    <StackPanel Margin="5,0,0,8"><TextBlock Text="目标 Y"/><TextBox x:Name="TargetY" Text="0" TextChanged="Field_TextChanged"/></StackPanel>
                    <StackPanel Margin="0,0,5,8"><TextBlock Text="焦段 mm"/><TextBox x:Name="Lens" Text="35" TextChanged="Field_TextChanged"/></StackPanel>
                    <StackPanel Margin="5,0,0,8"><TextBlock Text="光向 °"/><TextBox x:Name="Sun" Text="-45" TextChanged="Field_TextChanged"/></StackPanel>
                </UniformGrid>
                <TextBlock Text="版本历史" Margin="0,8,0,4"/><ComboBox x:Name="VersionList" DisplayMemberPath="Display" Height="34" SelectionChanged="VersionList_SelectionChanged"/>
                <Button Style="{StaticResource PrimaryButton}" Content="分析并保存新版本" Click="Save_Click" Margin="0,16,0,0"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel></ScrollViewer>
        </Border>
        <Border Grid.Column="2" Background="#101318" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid><Canvas x:Name="Stage" Background="#101318" MouseMove="Stage_MouseMove" MouseLeftButtonUp="Stage_MouseLeftButtonUp" MouseLeave="Stage_MouseLeave"/><Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#B315171B" CornerRadius="5" Padding="8" Margin="10"><TextBlock Text="紫色=机位　蓝色=拍摄目标　绿色=人物　橙线=轴线" Foreground="{StaticResource MutedBrush}"/></Border></Grid>
        </Border>
        <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/><RowDefinition Height="88"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="人物走位" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource NavButton}" Content="＋" Click="AddSubject_Click"/><Button Style="{StaticResource NavButton}" Content="－" Click="RemoveSubject_Click"/></StackPanel></Grid>
                <DataGrid x:Name="SubjectGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="#101318" Foreground="{StaticResource TextBrush}" RowBackground="#171A20" CellEditEnding="SubjectGrid_CellEditEnding"><DataGrid.Columns>
                    <DataGridTextColumn Header="角色" Binding="{Binding EntityKey}" Width="*"/><DataGridTextColumn Header="X" Binding="{Binding Position.X}" Width="55"/><DataGridTextColumn Header="Y" Binding="{Binding Position.Y}" Width="55"/><DataGridTextColumn Header="朝向" Binding="{Binding FacingDeg}" Width="62"/><DataGridTextColumn Header="姿态" Binding="{Binding Pose}" Width="85"/>
                </DataGrid.Columns></DataGrid>
                <StackPanel Grid.Row="2"><TextBlock Text="验收规则" FontWeight="SemiBold"/><TextBlock Text="人物在视锥外会告警；同场景相邻机位反向超过 150° 会提示越轴。保存的坐标、焦段、光向和人物走位供后续镜头生成复用。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
