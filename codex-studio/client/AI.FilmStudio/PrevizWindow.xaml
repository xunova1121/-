<Window x:Class="AI.FilmStudio.PrevizWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="场景预演台" Width="1100" Height="700" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
 <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="2D 场景预演台" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="固定场景坐标、人物位置、机位、焦段与光向；保存后形成版本指纹，供后续镜头稳定复用。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,18"/>
 <TextBlock Text="场景键"/><TextBox x:Name="SceneKey" Text="scene-01" Height="34" Padding="7" Margin="0,4,0,10"/><UniformGrid Columns="2"><StackPanel Margin="0,0,6,0"><TextBlock Text="机位 X"/><TextBox x:Name="CameraX" Text="0"/></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Text="机位 Y"/><TextBox x:Name="CameraY" Text="-5"/></StackPanel><StackPanel Margin="0,8,6,0"><TextBlock Text="目标 X"/><TextBox x:Name="TargetX" Text="0"/></StackPanel><StackPanel Margin="6,8,0,0"><TextBlock Text="目标 Y"/><TextBox x:Name="TargetY" Text="0"/></StackPanel><StackPanel Margin="0,8,6,0"><TextBlock Text="人物 X"/><TextBox x:Name="SubjectX" Text="0"/></StackPanel><StackPanel Margin="6,8,0,0"><TextBlock Text="人物 Y"/><TextBox x:Name="SubjectY" Text="0"/></StackPanel><StackPanel Margin="0,8,6,0"><TextBlock Text="焦段 mm"/><TextBox x:Name="Lens" Text="35"/></StackPanel><StackPanel Margin="6,8,0,0"><TextBlock Text="光向 °"/><TextBox x:Name="Sun" Text="-45"/></StackPanel></UniformGrid><Button Style="{StaticResource PrimaryButton}" Content="分析并保存版本" Click="Save_Click" Margin="0,18,0,0"/><TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel>
 <Border Grid.Column="1" Background="#12151A" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8"><Canvas x:Name="Stage"><Line x:Name="ViewLeft" Stroke="#7657E8" StrokeThickness="2"/><Line x:Name="ViewRight" Stroke="#7657E8" StrokeThickness="2"/><Ellipse x:Name="CameraDot" Width="24" Height="24" Fill="#7657E8"/><TextBlock x:Name="CameraLabel" Text="机位"/><Ellipse x:Name="SubjectDot" Width="30" Height="30" Fill="#36C979"/><TextBlock x:Name="SubjectLabel" Text="主角"/><Line x:Name="AxisLine" Stroke="#E0A534" StrokeDashArray="5,3" StrokeThickness="2"/></Canvas></Border></Grid>
</Window>
