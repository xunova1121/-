<Window x:Class="AI.FilmStudio.GenerationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI生成中心" Width="1380" Height="820" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/><RowDefinition Height="44"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="3"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="AI生成中心" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ProjectText" Foreground="{StaticResource MutedBrush}" Margin="14,5,16,0"/><TextBlock Text="集数" VerticalAlignment="Center"/><ComboBox x:Name="EpisodeSelector" Width="85" Height="34" Margin="8,0,0,0" SelectionChanged="EpisodeSelector_SelectionChanged"/></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource NavButton}" Content="模型设置" Click="Settings_Click"/></Grid>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="目标镜头"/><ComboBox x:Name="ShotSelector" Height="36" Margin="0,6,0,12" DisplayMemberPath="Display" SelectionChanged="ShotSelector_SelectionChanged"/>
            <TextBlock Text="生成类型"/><ComboBox x:Name="TaskType" Height="36" Margin="0,6,0,12" SelectedIndex="0" SelectionChanged="TaskType_SelectionChanged"><ComboBoxItem Content="image"/><ComboBoxItem Content="video"/><ComboBoxItem Content="voice"/></ComboBox>
            <TextBlock Text="模型提供方"/><ComboBox x:Name="ProviderSelector" Height="36" Margin="0,6,0,12" DisplayMemberPath="DisplayName"/>
            <TextBlock Text="模型名称（留空使用推荐值）"/><TextBox x:Name="ModelText" Height="36" Margin="0,6,0,12" Padding="8"/>
            <TextBlock Text="提示词 / 配音文本"/><TextBox x:Name="PromptText" Height="150" Margin="0,6,0,12" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
            <TextBlock Text="参考资产（视频可选首帧和尾帧）"/><ListBox x:Name="ReferenceList" Height="125" Margin="0,6,0,12" DisplayMemberPath="Name" SelectionMode="Extended" Background="#101318" Foreground="{StaticResource TextBrush}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="画面比例"/><ComboBox x:Name="Ratio" SelectedIndex="0" Margin="0,6,6,0"><ComboBoxItem Content="16:9"/><ComboBoxItem Content="9:16"/><ComboBoxItem Content="1:1"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="视频秒数"/><ComboBox x:Name="Duration" SelectedIndex="1" Margin="6,6,0,0"><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="8"/><ComboBoxItem Content="10"/><ComboBoxItem Content="12"/></ComboBox></StackPanel></Grid>
            <Button Style="{StaticResource PrimaryButton}" Content="提交当前镜头" Click="Generate_Click" Margin="0,16,0,0"/><Button Style="{StaticResource NavButton}" Content="批量提交全部镜头" Click="Batch_Click" Margin="0,6,0,0"/>
        </StackPanel></ScrollViewer></Border>
        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions><Grid><TextBlock Text="当前项目生成任务" FontSize="16" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Style="{StaticResource NavButton}" Content="刷新任务" Click="Refresh_Click"/></Grid>
            <DataGrid x:Name="TaskGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#101318" Foreground="{StaticResource TextBrush}" RowBackground="#171A20" AlternatingRowBackground="#1B1F26" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/><DataGridTextColumn Header="类型" Binding="{Binding TaskType}" Width="80"/><DataGridTextColumn Header="模型方" Binding="{Binding Provider}" Width="90"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="进度" Binding="{Binding Progress}" Width="65"/><DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="*"/><DataGridTextColumn Header="输出" Binding="{Binding OutputPath}" Width="220"/></DataGrid.Columns></DataGrid>
        </Grid></Border>
        <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
</Window>
