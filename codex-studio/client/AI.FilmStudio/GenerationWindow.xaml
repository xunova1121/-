<Window x:Class="AI.FilmStudio.GenerationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI生成中心" Width="1380" Height="820" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/><RowDefinition Height="44"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="3"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="AI生成中心" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ProjectText" Foreground="{StaticResource MutedBrush}" Margin="14,5,16,0"/><TextBlock Text="集数" VerticalAlignment="Center"/><ComboBox x:Name="EpisodeSelector" Width="85" Height="34" Margin="8,0,0,0" SelectionChanged="EpisodeSelector_SelectionChanged"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="GalleryButton" Style="{StaticResource PrimaryButton}" Content="结果审片画廊" Click="Gallery_Click"/><Button Style="{StaticResource NavButton}" Content="模型设置" Click="Settings_Click"/></StackPanel></Grid>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="目标镜头"/><ComboBox x:Name="ShotSelector" Height="36" Margin="0,6,0,12" DisplayMemberPath="Display" SelectionChanged="ShotSelector_SelectionChanged"/>
            <TextBlock Text="生成类型"/><ComboBox x:Name="TaskType" Height="36" Margin="0,6,0,12" SelectedIndex="0" SelectionChanged="TaskType_SelectionChanged"><ComboBoxItem Content="image"/><ComboBoxItem Content="video"/><ComboBoxItem Content="voice"/></ComboBox>
            <TextBlock Text="模型提供方"/><ComboBox x:Name="ProviderSelector" Height="36" Margin="0,6,0,12" DisplayMemberPath="DisplayName" SelectionChanged="ProviderSelector_SelectionChanged"/>
            <TextBlock Text="具体模型（自动读取服务商模型，也可手动输入）"/><ComboBox x:Name="ModelText" AutomationProperties.AutomationId="GenerationModelSelector" Height="40" Margin="0,6,0,12" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="DisplayName"/>
            <TextBlock Text="提示词 / 配音文本"/><TextBox x:Name="PromptText" Height="150" Margin="0,6,0,12" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
            <TextBlock Text="参考资产（只显示已批准的一致性资产）"/><ListBox x:Name="ReferenceList" Height="110" Margin="0,6,0,8" DisplayMemberPath="Name" SelectionMode="Extended" Background="#101318" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="视频素材解释方式"/><ComboBox x:Name="ReferenceMode" Height="34" SelectedIndex="0" Margin="0,6,0,12"><ComboBoxItem Content="首尾帧（最多2张，按选择顺序）" Tag="frames"/><ComboBoxItem Content="角色/场景参考图（秘塔 H3，最多9张）" Tag="reference"/></ComboBox>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="画面比例"/><ComboBox x:Name="Ratio" SelectedIndex="0" Margin="0,6,6,0"><ComboBoxItem Content="16:9"/><ComboBoxItem Content="9:16"/><ComboBoxItem Content="1:1"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="视频秒数"/><ComboBox x:Name="Duration" SelectedIndex="1" Margin="6,6,6,0"><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="8"/><ComboBoxItem Content="10"/><ComboBoxItem Content="12"/><ComboBoxItem Content="15"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="清晰度"/><ComboBox x:Name="Resolution" Margin="6,6,0,0"/></StackPanel></Grid>
            <Button x:Name="GenerateButton" AutomationProperties.AutomationId="SubmitCurrentShotButton" Style="{StaticResource PrimaryButton}" Content="提交当前镜头" Click="Generate_Click" Margin="0,16,0,0"/><Button x:Name="BatchButton" AutomationProperties.AutomationId="SubmitAllShotsButton" Style="{StaticResource NavButton}" Content="批量提交全部镜头" Click="Batch_Click" Margin="0,6,0,0"/>
        </StackPanel></ScrollViewer></Border>
        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="52"/></Grid.RowDefinitions><Grid><TextBlock Text="当前项目生成任务" FontSize="16" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Style="{StaticResource NavButton}" Content="刷新任务" Click="Refresh_Click"/></Grid>
            <DataGrid x:Name="TaskGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="TaskGrid_SelectionChanged" Background="#101318" Foreground="{StaticResource TextBrush}" RowBackground="#171A20" AlternatingRowBackground="#1B1F26" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/><DataGridTextColumn Header="类型" Binding="{Binding TaskType}" Width="80"/><DataGridTextColumn Header="模型方" Binding="{Binding Provider}" Width="90"/><DataGridTextColumn Header="路由" Binding="{Binding RouteState}" Width="165"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="进度" Binding="{Binding Progress}" Width="65"/><DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="*"/><DataGridTextColumn Header="输出" Binding="{Binding OutputPath}" Width="220"/></DataGrid.Columns></DataGrid>
            <Grid Grid.Row="2" Margin="0,9,0,0"><TextBlock Text="选择任务后可继续操作；失败任务无需重新填写提示词。" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OpenResultButton" Style="{StaticResource NavButton}" Content="打开结果" Click="OpenResult_Click" IsEnabled="False"/><Button x:Name="CancelTaskButton" Style="{StaticResource NavButton}" Content="取消任务" Click="CancelTask_Click" IsEnabled="False"/><Button x:Name="RetryTaskButton" Style="{StaticResource PrimaryButton}" Content="重试失败任务" Click="RetryTask_Click" IsEnabled="False"/></StackPanel></Grid>
        </Grid></Border>
        <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
</Window>