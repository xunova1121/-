<Window x:Class="AI.FilmStudio.ScriptWorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剧本工作台" Width="1320" Height="820" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="剧本工作台" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="ProjectNameText" Margin="14,5,22,0" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="集数" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="EpisodeSelector" Width="90" Height="34" SelectionChanged="EpisodeSelector_SelectionChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource NavButton}" Content="导入 TXT / MD / DOCX" Click="Import_Click"/>
                <Button Style="{StaticResource NavButton}" Content="保存剧本" Click="Save_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="解析剧本" Click="Parse_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="生成全量分镜" Click="Generate_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="剧本文本" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SourceNameText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                </Grid>
                <TextBox x:Name="ScriptEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Background="#101318" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource StrokeBrush}"
                         Padding="14" FontSize="15" FontFamily="Microsoft YaHei UI"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="解析结果" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                <Border Grid.Row="1" Background="#191D24" CornerRadius="6" Padding="12" Margin="0,4,0,10">
                    <StackPanel>
                        <TextBlock x:Name="ParseSummaryText" Text="尚未解析" FontSize="15"/>
                        <TextBlock x:Name="CharactersText" Text="人物：—" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="2" Text="场景顺序" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ListBox x:Name="SceneList" Grid.Row="3" DisplayMemberPath="Display" Background="#101318" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource StrokeBrush}" Padding="5"/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="可离线保存和解析；AI增强将在配置模型后启用。"/>
    </Grid>
</Window>
