<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AI-Film-Studio</AssemblyName>
    <RootNamespace>AI.FilmStudio</RootNamespace>
    <Version>0.5.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Embedded/AIStudioService.exe" LogicalName="AIStudioService.exe" Condition="Exists('Embedded/AIStudioService.exe')" />
  </ItemGroup>
</Project>
