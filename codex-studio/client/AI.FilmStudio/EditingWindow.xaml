<Window x:Class="AI.FilmStudio.EditingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪辑与成片" Width="1420" Height="820" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition/><RowDefinition Height="54"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="非线性剪辑与转场" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="真实素材入轨、裁切、排序、转场与 FFmpeg 成片导出" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource NavButton}" Content="导入视频" Click="Import_Click"/><Button Style="{StaticResource NavButton}" Content="从已生成镜头组装" Click="Build_Click"/><Button Style="{StaticResource NavButton}" Content="刷新" Click="Refresh_Click"/><Button Style="{StaticResource PrimaryButton}" Content="保存时间线" Click="Save_Click"/></StackPanel></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="ClipGrid" AutoGenerateColumns="False" CanUserAddRows="False" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource StrokeBrush}" GridLinesVisibility="Horizontal" RowBackground="#171A20" AlternatingRowBackground="#1B1F26" AlternationCount="2" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Position}" Width="45" IsReadOnly="True"/><DataGridTextColumn Header="轨" Binding="{Binding Track}" Width="50"/><DataGridTextColumn Header="片段" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="源文件" Binding="{Binding SourcePath}" Width="2*" IsReadOnly="True"/><DataGridTextColumn Header="入点(s)" Binding="{Binding TrimIn}" Width="75"/><DataGridTextColumn Header="尾裁(s)" Binding="{Binding TrimOut}" Width="75"/><DataGridTextColumn Header="时长(s)" Binding="{Binding Duration}" Width="75"/><DataGridComboBoxColumn Header="转场" SelectedItemBinding="{Binding Transition}" Width="95"><DataGridComboBoxColumn.ItemsSource><x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib"><sys:String>cut</sys:String><sys:String>dissolve</sys:String><sys:String>fade_black</sys:String></x:Array></DataGridComboBoxColumn.ItemsSource></DataGridComboBoxColumn><DataGridTextColumn Header="转场(s)" Binding="{Binding TransitionDuration}" Width="75"/><DataGridTextColumn Header="音量" Binding="{Binding Volume}" Width="65"/></DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="12,0,0,0"><StackPanel>
                <TextBlock Text="片段操作" FontSize="17" FontWeight="SemiBold"/><UniformGrid Columns="2" Margin="0,12,0,20"><Button Style="{StaticResource NavButton}" Content="上移" Click="Up_Click"/><Button Style="{StaticResource NavButton}" Content="下移" Click="Down_Click"/><Button Style="{StaticResource NavButton}" Content="打开源文件" Click="Open_Click"/><Button Style="{StaticResource NavButton}" Content="删除" Click="Delete_Click"/></UniformGrid>
                <Separator/><TextBlock Text="导出设置" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,10"/><TextBlock Text="分辨率" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="Resolution" SelectedIndex="1" Height="34" Margin="0,5,0,10"><ComboBoxItem Tag="1280x720">720p</ComboBoxItem><ComboBoxItem Tag="1920x1080">1080p</ComboBoxItem><ComboBoxItem Tag="3840x2160">4K</ComboBoxItem></ComboBox><TextBlock Text="帧率" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="FrameRate" SelectedIndex="0" Height="34" Margin="0,5,0,10"><ComboBoxItem>24</ComboBoxItem><ComboBoxItem>25</ComboBoxItem><ComboBoxItem>30</ComboBoxItem><ComboBoxItem>60</ComboBoxItem></ComboBox><TextBlock Text="质量" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="Quality" SelectedIndex="2" Height="34" Margin="0,5,0,10"><ComboBoxItem Tag="draft">草稿</ComboBoxItem><ComboBoxItem Tag="standard">标准</ComboBoxItem><ComboBoxItem Tag="high">高质量</ComboBoxItem></ComboBox><TextBlock Text="成片名称" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="OutputName" Text="第1集-成片.mp4" Height="34" Padding="7" Margin="0,5,0,14"/><Button Style="{StaticResource PrimaryButton}" Content="开始导出成片" Click="Export_Click"/><Button Style="{StaticResource NavButton}" Content="查看导出任务" Click="Tasks_Click" Margin="0,8,0,0"/>
            </StackPanel></Border>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
    </Grid>
</Window>
