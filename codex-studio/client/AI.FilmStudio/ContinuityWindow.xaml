<Window x:Class="AI.FilmStudio.ContinuityWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="连续性审校" Width="980" Height="650" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition/><RowDefinition Height="48"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="镜间连续性审校" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="检查跨集人物、服装、伤势、道具状态，以及同场轴线与光照；阻断项不会进入批量生产。" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" Width="160" Background="#203D2E" CornerRadius="8" Padding="12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="ScoreText" Text="--" FontSize="30" Foreground="#57C582"/><TextBlock Text=" 分" VerticalAlignment="Bottom" Margin="2,0,0,5"/></StackPanel></Border></Grid>
 <DataGrid x:Name="FindingGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource StrokeBrush}" RowBackground="#171A20"><DataGrid.Columns><DataGridTextColumn Header="镜间" Binding="{Binding Shot}" Width="120"/><DataGridTextColumn Header="发现" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="修复建议" Binding="{Binding ActionText}" Width="220"/><DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="90"/></DataGrid.Columns></DataGrid>
 <Grid Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Content="重新分析" Click="Analyze_Click"/></Grid></Grid>
</Window>
