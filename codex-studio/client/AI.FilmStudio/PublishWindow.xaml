<Window x:Class="AI.FilmStudio.PublishWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发布中心" Width="1100" Height="700" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition/><RowDefinition Height="55"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="成片发布中心" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="选择已完成的成片任务，复制到交付目录；发布不会改变工程母版。" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource NavButton}" Content="刷新任务" Click="Refresh_Click"/></Grid>
        <DataGrid x:Name="ExportGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource StrokeBrush}" RowBackground="#171A20" AlternatingRowBackground="#1B1F26" AlternationCount="2">
            <DataGrid.Columns><DataGridTextColumn Header="任务" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="进度" Binding="{Binding Progress}" Width="80"/><DataGridTextColumn Header="成片路径" Binding="{Binding OutputPath}" Width="*"/><DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="220"/></DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource NavButton}" Content="打开成片" Click="Open_Click"/><Button Style="{StaticResource PrimaryButton}" Content="复制到交付目录" Click="Publish_Click" Margin="8,0,0,0"/></StackPanel></Grid>
    </Grid>
</Window>
