<Window x:Class="AI.FilmStudio.StoryBibleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设定集" Width="1240" Height="800" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid Grid.ColumnSpan="3"><StackPanel><TextBlock Text="设定集 · 角色 / 场景 / 道具" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="直接查看和管理参考图；高级参数默认收起。" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource NavButton}" Content="新建设定" Click="New_Click"/><Button Style="{StaticResource NavButton}" Content="刷新" Click="Refresh_Click"/></StackPanel></Grid>
  <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
   <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions>
    <ComboBox x:Name="Filter" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged"><ComboBoxItem Content="全部设定" Tag=""/><ComboBoxItem Content="人物" Tag="character"/><ComboBoxItem Content="场景" Tag="location"/><ComboBoxItem Content="道具" Tag="prop"/><ComboBoxItem Content="世界观" Tag="world"/><ComboBoxItem Content="风格" Tag="style"/></ComboBox>
    <ListBox x:Name="EntityList" Grid.Row="1" Background="#101318" Foreground="{StaticResource TextBrush}" SelectionChanged="EntityList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Margin="3" Padding="8" Background="#171C23" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="68" Height="68" Background="#090B0F" CornerRadius="5"><Grid><TextBlock Text="暂无图片" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/><Image Source="{Binding PrimaryImagePath}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding TypeText}" Foreground="#9DB5FF" Margin="0,4,0,0"/><TextBlock Text="{Binding StateText}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid>
  </Border>
  <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,7,0"><TextBlock Text="类型"/><ComboBox x:Name="EntityType" SelectedIndex="0" Height="34" Margin="0,5,0,12"><ComboBoxItem Content="人物" Tag="character"/><ComboBoxItem Content="场景" Tag="location"/><ComboBoxItem Content="道具" Tag="prop"/><ComboBoxItem Content="世界观" Tag="world"/><ComboBoxItem Content="风格" Tag="style"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="唯一键"/><TextBox x:Name="EntityKey" Height="34" Padding="7" Margin="0,5,0,12"/></StackPanel></Grid>
    <TextBlock Text="名称"/><TextBox x:Name="EntityName" Height="34" Padding="7" Margin="0,5,0,12"/>
    <Grid><TextBlock Text="设定参考图" FontSize="18" FontWeight="Bold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource NavButton}" Content="添加图片" Click="AddReference_Click"/><Button Style="{StaticResource NavButton}" Content="移除图片" Click="RemoveReference_Click"/></StackPanel></Grid>
    <ListBox x:Name="ReferenceList" Height="285" Background="#101318" Foreground="{StaticResource TextBrush}" Margin="0,8,0,12" SelectionMode="Single"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="200" Margin="6" Padding="8" Background="#171C23" BorderBrush="#4A5361" BorderThickness="1" CornerRadius="7"><StackPanel><Border Height="160" Background="#090B0F" CornerRadius="5"><Grid><TextBlock Text="图片不可用" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Path}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Expander Header="高级设定参数（一般无需修改）" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"><TextBox x:Name="DataJson" Height="180" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="9" Margin="0,8,0,0"/></Expander>
    <CheckBox x:Name="Frozen" Content="冻结此版本（进入自动生产后不可被模型自行改写）" IsChecked="True" Foreground="{StaticResource TextBrush}"/><Button Style="{StaticResource PrimaryButton}" Content="保存为新版本" Click="Save_Click" Margin="0,15,0,0"/>
   </StackPanel></ScrollViewer></Border>
  <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="3" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
 </Grid>
</Window>