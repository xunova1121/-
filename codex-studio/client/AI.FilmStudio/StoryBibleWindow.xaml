<Window x:Class="AI.FilmStudio.StoryBibleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Story Bible 一致性设定" Width="1180" Height="760" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition/><RowDefinition Height="48"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid Grid.ColumnSpan="3"><StackPanel><TextBlock Text="Story Bible · 冻结设定" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="每次保存创建新版本；冻结版本会自动写入所有关键帧和视频提示词。" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource NavButton}" Content="新建设定" Click="New_Click"/><Button Style="{StaticResource NavButton}" Content="刷新" Click="Refresh_Click"/></StackPanel></Grid>
  <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions><ComboBox x:Name="Filter" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged"><ComboBoxItem Content="全部设定" Tag=""/><ComboBoxItem Content="人物" Tag="character"/><ComboBoxItem Content="场景" Tag="location"/><ComboBoxItem Content="道具" Tag="prop"/><ComboBoxItem Content="世界观" Tag="world"/><ComboBoxItem Content="风格" Tag="style"/></ComboBox><ListBox x:Name="EntityList" Grid.Row="1" DisplayMemberPath="Display" Background="#101318" Foreground="{StaticResource TextBrush}" SelectionChanged="EntityList_SelectionChanged"/></Grid></Border>
  <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,7,0"><TextBlock Text="类型"/><ComboBox x:Name="EntityType" SelectedIndex="0" Height="34" Margin="0,5,0,12"><ComboBoxItem Content="人物" Tag="character"/><ComboBoxItem Content="场景" Tag="location"/><ComboBoxItem Content="道具" Tag="prop"/><ComboBoxItem Content="世界观" Tag="world"/><ComboBoxItem Content="风格" Tag="style"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="唯一键"/><TextBox x:Name="EntityKey" Height="34" Padding="7" Margin="0,5,0,12"/></StackPanel></Grid><TextBlock Text="名称"/><TextBox x:Name="EntityName" Height="34" Padding="7" Margin="0,5,0,12"/><TextBlock Text="结构化记忆 JSON"/><TextBox x:Name="DataJson" Height="270" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="9" Margin="0,5,0,12"/><Grid><TextBlock Text="参考图/参考资产文件"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource NavButton}" Content="添加文件" Click="AddReference_Click"/><Button Style="{StaticResource NavButton}" Content="移除" Click="RemoveReference_Click"/></StackPanel></Grid><ListBox x:Name="ReferenceList" Height="100" Background="#101318" Foreground="{StaticResource TextBrush}" Margin="0,6,0,12"/><CheckBox x:Name="Frozen" Content="冻结此版本（进入自动生产后不可被模型自行改写）" IsChecked="True" Foreground="{StaticResource TextBrush}"/><Button Style="{StaticResource PrimaryButton}" Content="保存为新版本" Click="Save_Click" Margin="0,15,0,0"/></StackPanel></ScrollViewer></Border>
  <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="3" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
 </Grid>
</Window>
