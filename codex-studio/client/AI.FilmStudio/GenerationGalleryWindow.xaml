<Window x:Class="AI.FilmStudio.GenerationGalleryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="生成结果审片画廊" Width="1280" Height="780" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition/><RowDefinition Height="58"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="生成结果审片画廊" FontSize="26" FontWeight="Bold"/><TextBlock Text="同一镜头可保留多个候选；采用一个结果不会删除其他候选。" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><ComboBox x:Name="TypeFilter" Width="150" Height="38" SelectedIndex="0" SelectionChanged="TypeFilter_SelectionChanged"><ComboBoxItem Content="全部结果" Tag=""/><ComboBoxItem Content="图片" Tag="image"/><ComboBoxItem Content="视频" Tag="video"/><ComboBoxItem Content="配音" Tag="voice"/></ComboBox><Button Style="{StaticResource NavButton}" Content="刷新" Click="Refresh_Click"/></StackPanel></Grid>
  <ListBox x:Name="Gallery" Grid.Row="1" Background="#0B0E13" BorderBrush="#687386" SelectionMode="Single" SelectionChanged="Gallery_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
   <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemTemplate><DataTemplate><Border Width="270" Margin="9" Padding="10" Background="#171C23" BorderBrush="#4A5361" BorderThickness="1" CornerRadius="8"><StackPanel><Border Height="175" Background="#090B0F" CornerRadius="6"><Grid><TextBlock Text="视频 / 音频结果&#x0a;双击或点击下方打开" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding PreviewPath}" Stretch="UniformToFill"/></Grid></Border><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding ReviewText}" Foreground="#75E6A4" FontWeight="Bold"/></Grid><TextBlock Text="{Binding MetaText}" Foreground="#9DB5FF" Margin="0,6,0,0"/><TextBlock Text="{Binding CreatedAt}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Grid Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,330,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="OpenButton" Style="{StaticResource NavButton}" Content="打开查看" Click="Open_Click" IsEnabled="False"/><Button x:Name="AdoptButton" Style="{StaticResource PrimaryButton}" Content="✓ 采用当前候选" Click="Adopt_Click" IsEnabled="False"/></StackPanel></Grid>
 </Grid>
</Window>