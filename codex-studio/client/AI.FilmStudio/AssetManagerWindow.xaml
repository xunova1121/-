<Window x:Class="AI.FilmStudio.AssetManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一致性资产审批" Width="1280" Height="800" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition/><RowDefinition Height="54"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="一致性资产审批" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="ProjectText" Foreground="{StaticResource MutedBrush}" Margin="14,7,0,0"/></StackPanel>
                <TextBlock Text="先为人物、场景、道具补齐多视图并批准版本；正式生成只使用已批准资产。" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ReferenceModeButton" Style="{StaticResource ActiveNavButton}" Content="多视图审批" Click="ReferenceMode_Click"/>
                <Button x:Name="AllAssetsModeButton" Style="{StaticResource NavButton}" Content="全部生产素材" Click="AllAssetsMode_Click"/>
                <Button Style="{StaticResource NavButton}" Content="刷新" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="ReferencePanel" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="1. 选择设定对象" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Text="来自 Story Bible 的人物、场景和道具" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <ListBox x:Name="EntityList" Grid.Row="2" SelectionChanged="EntityList_SelectionChanged" AutomationProperties.AutomationId="ReferenceEntityList">
                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding TypeText}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#FFD166" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid><Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition/><RowDefinition Height="74"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock x:Name="BoardTitle" Text="2. 选择左侧对象" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="RequirementText" Text="人物需正面、侧面、全身；场景需全景、反向；道具需正面、细节。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,16,0"/><TextBlock x:Name="ApprovalStatusText" Text="尚未选择" Foreground="#FFD166" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,16,0" AutomationProperties.AutomationId="ReferenceApprovalStatus"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="ApproveButton" Style="{StaticResource PrimaryButton}" Content="✓ 批准当前多视图" Click="Approve_Click" IsEnabled="False" AutomationProperties.AutomationId="ApproveReferenceBoardButton"/><Button x:Name="RevokeButton" Style="{StaticResource NavButton}" Content="撤销批准" Click="Revoke_Click" IsEnabled="False" AutomationProperties.AutomationId="RevokeReferenceBoardButton"/></StackPanel>
                    </Grid>
                    <ListBox x:Name="CandidateList" Grid.Row="1" SelectionMode="Extended" Background="#0B0E13" BorderBrush="#687386" AutomationProperties.AutomationId="ReferenceCandidateList">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate><Border Width="230" Margin="7" Padding="10" Background="#171C23" BorderBrush="#4A5361" BorderThickness="1" CornerRadius="7"><StackPanel><Border Height="150" Background="#090B0F" CornerRadius="5"><Grid><TextBlock Text="图片不可用" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding PreviewPath}" Stretch="UniformToFill"/></Grid></Border><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ViewLabel}" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding ApprovalText}" Foreground="#75E6A4"/></Grid><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="3. 选择视图类型并导入图片；同一视图可保留多个候选，批准时采用每类最新候选。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox x:Name="ViewRole" Width="150" SelectedIndex="0" AutomationProperties.AutomationId="ReferenceViewRole"><ComboBoxItem Content="正面" Tag="front"/><ComboBoxItem Content="侧面" Tag="profile"/><ComboBoxItem Content="全身" Tag="full_body"/><ComboBoxItem Content="背面" Tag="back"/><ComboBoxItem Content="全景" Tag="wide"/><ComboBoxItem Content="反向" Tag="reverse"/><ComboBoxItem Content="细节" Tag="detail"/><ComboBoxItem Content="俯视" Tag="top"/></ComboBox><Button x:Name="ImportViewButton" Style="{StaticResource PrimaryButton}" Content="导入此视图" Click="ImportView_Click" IsEnabled="False" AutomationProperties.AutomationId="ImportReferenceViewButton"/></StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="AllAssetsPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition/></Grid.RowDefinitions>
            <Grid><TextBlock Text="全部生产素材" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><ComboBox x:Name="TypeFilter" Width="150" SelectedIndex="0" SelectionChanged="TypeFilter_SelectionChanged"><ComboBoxItem Content="全部" Tag=""/><ComboBoxItem Content="人物参考" Tag="character"/><ComboBoxItem Content="场景参考" Tag="scene"/><ComboBoxItem Content="道具参考" Tag="prop"/><ComboBoxItem Content="图片" Tag="image"/><ComboBoxItem Content="视频" Tag="video"/><ComboBoxItem Content="配音" Tag="voice"/><ComboBoxItem Content="音乐" Tag="music"/></ComboBox><ComboBox x:Name="ImportType" Width="150" SelectedIndex="0" Margin="8,0,0,0"><ComboBoxItem Content="自动识别" Tag="auto"/><ComboBoxItem Content="图片" Tag="image"/><ComboBoxItem Content="视频" Tag="video"/><ComboBoxItem Content="配音" Tag="voice"/><ComboBoxItem Content="音乐" Tag="music"/></ComboBox><Button Style="{StaticResource PrimaryButton}" Content="导入普通素材" Click="Import_Click"/></StackPanel></Grid>
            <ListBox x:Name="AssetGrid" Grid.Row="1" SelectionMode="Single" Background="#0B0E13" BorderBrush="#687386" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate><Border Width="250" Margin="8" Padding="10" Background="#171C23" BorderBrush="#4A5361" BorderThickness="1" CornerRadius="7"><StackPanel><Border Height="165" Background="#090B0F" CornerRadius="5"><Grid><TextBlock Text="无图片预览" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding PreviewPath}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MetaText}" Foreground="#9DB5FF" Margin="0,5,0,0"/><TextBlock Text="{Binding CreatedAt}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="2"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,270,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource NavButton}" Content="打开选中文件" Click="Open_Click"/><Button Style="{StaticResource NavButton}" Content="删除候选/素材" Click="Delete_Click"/></StackPanel></Grid>
    </Grid>
</Window>