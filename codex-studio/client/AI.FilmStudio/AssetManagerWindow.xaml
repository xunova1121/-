<Window x:Class="AI.FilmStudio.AssetManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="资产管理" Width="1240" Height="760" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/><RowDefinition Height="46"/></Grid.RowDefinitions>
        <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="资产管理" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ProjectText" Foreground="{StaticResource MutedBrush}" Margin="14,5,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="TypeFilter" Width="120" SelectedIndex="0" SelectionChanged="TypeFilter_SelectionChanged"><ComboBoxItem Content="全部" Tag=""/><ComboBoxItem Content="人物参考" Tag="character"/><ComboBoxItem Content="场景参考" Tag="scene"/><ComboBoxItem Content="道具参考" Tag="prop"/><ComboBoxItem Content="图片" Tag="image"/><ComboBoxItem Content="视频" Tag="video"/><ComboBoxItem Content="配音" Tag="voice"/><ComboBoxItem Content="音乐" Tag="music"/></ComboBox>
                <ComboBox x:Name="ImportType" Width="130" SelectedIndex="0" Margin="8,0,0,0" ToolTip="导入时归类"><ComboBoxItem Content="自动识别" Tag="auto"/><ComboBoxItem Content="人物参考" Tag="character"/><ComboBoxItem Content="场景参考" Tag="scene"/><ComboBoxItem Content="道具参考" Tag="prop"/><ComboBoxItem Content="图片" Tag="image"/><ComboBoxItem Content="视频" Tag="video"/><ComboBoxItem Content="配音" Tag="voice"/><ComboBoxItem Content="音乐" Tag="music"/></ComboBox>
                <Button Style="{StaticResource NavButton}" Content="刷新" Click="Refresh_Click"/><Button Style="{StaticResource PrimaryButton}" Content="导入资产" Click="Import_Click"/>
            </StackPanel></Grid>
        <DataGrid x:Name="AssetGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource StrokeBrush}" RowBackground="#171A20" AlternatingRowBackground="#1B1F26" AlternationCount="2">
            <DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/><DataGridTextColumn Header="类型" Binding="{Binding AssetType}" Width="90"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="集" Binding="{Binding Episode}" Width="50"/><DataGridTextColumn Header="镜头" Binding="{Binding ShotText}" Width="65"/><DataGridTextColumn Header="来源" Binding="{Binding SourceKind}" Width="90"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/><DataGridTextColumn Header="本地文件" Binding="{Binding LocalPath}" Width="*"/><DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="160"/></DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource NavButton}" Content="打开文件" Click="Open_Click"/><Button Style="{StaticResource NavButton}" Content="删除资产" Click="Delete_Click"/></StackPanel></Grid>
    </Grid>
</Window>
