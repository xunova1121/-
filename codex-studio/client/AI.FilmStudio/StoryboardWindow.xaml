<Window x:Class="AI.FilmStudio.StoryboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分镜工作台" Width="1440" Height="820" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="全量分镜工作台" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="ProjectNameText" Foreground="{StaticResource MutedBrush}" Margin="14,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource NavButton}" Content="场景预演台" Click="Previz_Click"/>
                <Button Style="{StaticResource NavButton}" Content="连续性审校" Click="Continuity_Click"/>
                <Button Style="{StaticResource NavButton}" Content="刷新" Click="Refresh_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="保存全部修改" Click="SaveAll_Click"/>
            </StackPanel>
        </Grid>
        <DataGrid x:Name="ShotGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource StrokeBrush}"
                  GridLinesVisibility="Horizontal" RowBackground="#171A20" AlternatingRowBackground="#1B1F26" AlternationCount="2"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="55" IsReadOnly="True"/>
                <DataGridTextColumn Header="场" Binding="{Binding SceneId}" Width="55" IsReadOnly="True"/>
                <DataGridTextColumn Header="景别" Binding="{Binding ShotType, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="运镜" Binding="{Binding Camera, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTextColumn Header="标题" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                <DataGridTextColumn Header="动作 / 画面" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTextColumn Header="对白" Binding="{Binding Dialogue, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                <DataGridTextColumn Header="人物" Binding="{Binding CharacterText}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="时长" Binding="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                <DataGridTextColumn Header="生成提示词" Binding="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
</Window>
