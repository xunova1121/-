<Window x:Class="AI.FilmStudio.ProviderSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="模型路由中心" Width="1080" Height="720" MinWidth="940" MinHeight="640" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="模型路由中心" FontSize="28" FontWeight="Bold"/><TextBlock Text="第一步保存服务商连接，第二步拉取账号可用模型，第三步把具体模型绑定到制作岗位。" Foreground="#B9C4D6" FontSize="15" Margin="0,8,0,20"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#171A20" BorderBrush="#3B4350" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel>
        <TextBlock Text="1. 服务商连接与模型目录" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <TextBlock Text="服务商"/><ComboBox x:Name="Provider" AutomationProperties.AutomationId="ProviderSelector" Height="40" FontSize="15" Margin="0,6,0,14" SelectionChanged="Provider_SelectionChanged"><ComboBoxItem Tag="openai">OpenAI 标准接口</ComboBoxItem><ComboBoxItem Tag="ark">火山方舟 OpenAI 兼容接口</ComboBoxItem></ComboBox>
        <TextBlock Text="API Base URL"/><TextBox x:Name="BaseUrl" Height="40" FontSize="15" Padding="10" Margin="0,6,0,14"/>
        <TextBlock Text="默认模型 / Endpoint ID"/><TextBox x:Name="Model" Height="40" FontSize="15" Padding="10" Margin="0,6,0,14"/>
        <TextBlock Text="API 密钥（留空保留旧密钥）"/><PasswordBox x:Name="ApiKey" Height="40" FontSize="15" Padding="10" Margin="0,6,0,16"/>
        <StackPanel Orientation="Horizontal"><Button x:Name="SaveButton" AutomationProperties.AutomationId="SaveProviderButton" Style="{StaticResource PrimaryButton}" Content="加密保存连接" Click="Save_Click"/><Button x:Name="FetchButton" AutomationProperties.AutomationId="FetchModelsButton" Style="{StaticResource NavButton}" Content="拉取可用模型" Click="FetchModels_Click" Margin="10,0,0,0"/></StackPanel>
        <TextBlock x:Name="Status" Foreground="#8FE3A7" FontSize="14" Margin="0,14,0,0"/><TextBlock x:Name="Feedback" Foreground="#F2C15B" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Background="#171A20" BorderBrush="#3B4350" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel>
        <TextBlock Text="2. 功能岗位绑定" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="选择岗位和刚拉取的模型，点击确认。真实任务将按岗位自动路由，不再手填服务商。" Foreground="#B9C4D6" FontSize="14" TextWrapping="Wrap" Margin="0,7,0,16"/>
        <TextBlock Text="制作岗位"/><ComboBox x:Name="Role" AutomationProperties.AutomationId="ModelRoleSelector" Height="40" FontSize="15" DisplayMemberPath="Name" Margin="0,6,0,14" SelectionChanged="Role_SelectionChanged"/>
        <TextBlock x:Name="RolePurpose" Text="选择岗位后显示职责" Foreground="#B9C4D6" TextWrapping="Wrap" MinHeight="42"/>
        <TextBlock Text="绑定模型" Margin="0,14,0,0"/><ComboBox x:Name="AvailableModels" AutomationProperties.AutomationId="AvailableModelSelector" Height="40" FontSize="15" Margin="0,6,0,14" IsEditable="True"/>
        <Button x:Name="BindButton" AutomationProperties.AutomationId="ConfirmModelBindingButton" Style="{StaticResource PrimaryButton}" Content="确认绑定此岗位" Click="Bind_Click" HorizontalAlignment="Left"/>
        <TextBlock Text="当前绑定" FontWeight="SemiBold" Margin="0,22,0,8"/><ListBox x:Name="RouteList" AutomationProperties.AutomationId="BoundModelRoutes" Height="190" DisplayMemberPath="Display" FontSize="14" Background="#101318" Foreground="White" BorderBrush="#3B4350"/>
        <TextBlock x:Name="RouteFeedback" Foreground="#8FE3A7" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel></Border>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><TextBlock Text="密钥由 Windows DPAPI 加密且不会回显。" Foreground="#B9C4D6" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Style="{StaticResource NavButton}" Content="关闭" Click="Close_Click"/></StackPanel>
  </Grid>
</Window>
