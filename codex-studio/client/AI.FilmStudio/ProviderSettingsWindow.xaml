<Window x:Class="AI.FilmStudio.ProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型路由中心" Width="1180" Height="780" MinWidth="1040" MinHeight="700" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="模型路由中心" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="先连接服务商并拉取账户可用模型，再把具体模型绑定到剧本、分镜、制作与质检岗位。密钥由 Windows DPAPI 加密。" FontSize="16" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
            <Border Background="#171A20" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="22">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="1. 服务商连接" FontSize="21" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="Provider" Height="46" DisplayMemberPath="Name" SelectionChanged="Provider_SelectionChanged"/>
                        <TextBlock x:Name="Status" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="API Base URL" FontWeight="SemiBold"/><TextBox x:Name="BaseUrl" Height="46" Margin="0,7,0,0"/></StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,18,0,0"><TextBlock Text="默认模型 / Endpoint ID" FontWeight="SemiBold"/><ComboBox x:Name="Model" Height="46" Margin="0,7,0,0" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="DisplayName"/></StackPanel>
                    <StackPanel Grid.Row="4" Margin="0,18,0,0"><TextBlock Text="API 密钥（留空保留已保存密钥）" FontWeight="SemiBold"/><PasswordBox x:Name="ApiKey" Height="46" Margin="0,7,0,0"/></StackPanel>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="FetchButton" Style="{StaticResource NavButton}" Content="拉取可用模型" Click="FetchModels_Click" Padding="20,11"/><Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="加密保存连接" Click="Save_Click" Margin="10,0,0,0" Padding="20,11"/></StackPanel>
                    <TextBlock x:Name="Feedback" Grid.Row="6" Foreground="#F3B746" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#171A20" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="22">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="2. 功能岗位绑定" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="每个功能可以使用不同服务商和模型；一键生产与导演工作台会按这里的绑定执行。" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
                    <ListBox x:Name="RoleList" Grid.Row="1" Margin="0,16,0,0" DisplayMemberPath="DisplayLabel" SelectionChanged="RoleList_SelectionChanged"/>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="RoleName" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="RoleDescription" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
                    <Grid Grid.Row="3" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="绑定服务商" FontWeight="SemiBold"/><ComboBox x:Name="RoleProvider" Height="46" Margin="0,7,0,0" DisplayMemberPath="Name" SelectionChanged="RoleProvider_SelectionChanged"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="绑定模型" FontWeight="SemiBold"/><ComboBox x:Name="RoleModel" Height="46" Margin="0,7,0,0" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="DisplayName"/></StackPanel>
                    </Grid>
                    <TextBlock x:Name="RoleRequirement" Grid.Row="4" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="FetchRoleButton" Style="{StaticResource NavButton}" Content="拉取候选模型" Click="FetchRoleModels_Click" Padding="16,10"/><Button x:Name="BindRoleButton" Style="{StaticResource PrimaryButton}" Content="保存绑定" Click="BindRole_Click" Margin="8,0,0,0" Padding="16,10"/><Button x:Name="ClearRoleButton" Style="{StaticResource NavButton}" Content="清除绑定" Click="ClearRole_Click" Margin="8,0,0,0" Padding="16,10"/></StackPanel>
                    <TextBlock x:Name="RoleFeedback" Grid.Row="6" Foreground="#F3B746" TextWrapping="Wrap" Margin="0,13,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Row="2" Style="{StaticResource NavButton}" Content="关闭" Click="Close_Click" Padding="26,12" HorizontalAlignment="Right"/>
    </Grid>
</Window>
