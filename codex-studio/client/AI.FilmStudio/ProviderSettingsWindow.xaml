<Window x:Class="AI.FilmStudio.ProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型连接" Width="680" Height="530" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="真实模型连接" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="密钥使用 Windows DPAPI 加密，仅当前 Windows 用户可以解密；不会显示或写入日志。" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
        <Border Grid.Row="1" Background="#171A20" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,20,0,16">
            <StackPanel Orientation="Horizontal"><TextBlock Text="提供方" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="Provider" Width="280" Height="36" SelectionChanged="Provider_SelectionChanged"><ComboBoxItem Tag="openai">OpenAI 标准接口</ComboBoxItem><ComboBoxItem Tag="ark">火山方舟 OpenAI 兼容接口</ComboBoxItem></ComboBox><TextBlock x:Name="Status" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></StackPanel>
        </Border>
        <StackPanel Grid.Row="2">
            <TextBlock Text="API Base URL"/><TextBox x:Name="BaseUrl" Height="38" Padding="9" Margin="0,6,0,15"/>
            <TextBlock Text="模型 / Endpoint ID"/><TextBox x:Name="Model" Height="38" Padding="9" Margin="0,6,0,15"/>
            <TextBlock Text="API 密钥（留空则保留已保存密钥）"/><PasswordBox x:Name="ApiKey" Height="38" Padding="9" Margin="0,6,0,0"/>
            <TextBlock x:Name="Feedback" Foreground="#E0A534" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource NavButton}" Content="关闭" Click="Close_Click"/><Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="加密保存" Click="Save_Click" Margin="8,0,0,0"/></StackPanel>
    </Grid>
</Window>
