{
  "name": "jarvis-desktop",
  "productName": "Jarvis",
  "version": "1.0.0",
  "description": "贾维斯桌面版：多模型个人智能体，能操作电脑、连接 MCP 工具",
  "author": "Jarvis",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.mjs",
  "scripts": {
    "prepare-app": "node scripts/prepare.mjs",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder",
    "dist:win": "npm run prepare-app && electron-builder --win",
    "dist:mac": "npm run prepare-app && electron-builder --mac",
    "dist:linux": "npm run prepare-app && electron-builder --linux",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "Jarvis",
    "copyright": "Jarvis",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.mjs", "preload.cjs", "ops.mjs", "input.mjs", "control.mjs", "package.json", "build/icon.png", "bundle/**/*"],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "zip", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "Jarvis-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "贾维斯",
      "uninstallDisplayName": "贾维斯",
      "artifactName": "Jarvis-Setup-${version}.${ext}",
      "installerLanguages": ["zh_CN", "en_US"],
      "language": "2052"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Jarvis-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "直接对话和唤醒词需要使用麦克风（语音活动检测在本机完成）。",
        "NSCameraUsageDescription": "人脸跟随需要使用摄像头（画面只在本机处理，不会上传）。"
      }
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "Jarvis-${version}-linux-${arch}.${ext}"
    }
  }
}
