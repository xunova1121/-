{
  "name": "jarvis-agent",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval:check": "node --test evals/checks.mjs",
    "eval:agent": "node evals/runner.mjs",
    "build-model": "node scripts/build-hologram.mjs",
    "server": "node server/server.mjs",
    "start": "vite build && node server/server.mjs",
    "postinstall": "node scripts/vendor-assets.mjs",
    "e2e": "node e2e/smoke.mjs",
    "build:standalone": "vite build --mode standalone && node -e \"require('fs').copyFileSync('dist-standalone/index.html','../jarvis-standalone.html')\"",
    "e2e:standalone": "node e2e/standalone.mjs",
    "build:mobile": "vite build --mode mobile",
    "android": "vite build --mode mobile && cap sync android"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "playwright": "1.56.1",
    "prettier": "3.9.9",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@ricky0123/vad-web": "^0.0.31",
    "docx": "^9.10.0",
    "docx-preview": "0.4.1",
    "exceljs": "4.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "18.0.14",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^4.0.1",
    "three": "0.162.0",
    "ws": "8.22.0",
    "xlsx": "^0.18.5"
  }
}
