{
  "name": "jarvis-agent",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build-model": "node scripts/build-hologram.mjs",
    "server": "node server/server.mjs",
    "start": "vite build && node server/server.mjs",
    "postinstall": "node scripts/vendor-assets.mjs",
    "e2e": "node e2e/smoke.mjs",
    "build:standalone": "vite build --mode standalone && node -e \"require('fs').copyFileSync('dist-standalone/index.html','../jarvis-standalone.html')\"",
    "e2e:standalone": "node e2e/standalone.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@ricky0123/vad-web": "^0.0.31",
    "three": "0.162.0"
  }
}
